---
import BaseLayout from "../layouts/BaseLayout.astro";

const skills = [
  { title: "Cloud computing", items: ["Google Cloud", "AWS", "Azure"] },
  { title: "Backend development", items: ["Python", "FastAPI", "FastMCP", "REST APIs", "Redis", "PostgreSQL", "MongoDB", "Git", "GitHub", "Pytest"] },
  { title: "AI agent architecture", items: ["LangChain", "LangGraph", "LlamaIndex", "CrewAI", "ADK", "MCP", "RAG", "Function & tool calling", "Agent memory", "A2A protocol"] },
  { title: "Evaluation & MLOps / LLMOps", items: ["Ragas", "DeepEval", "LangSmith", "LangFuse", "OTEL", "DVC", "GitHub Actions", "Docker"] },
];

const experience = [
  {
    company: "Banco Davivienda",
    role: "AI First Engineer",
    period: "2026 – Present",
    description: "Designing and implementing Generative AI services, with a focus on AI agent frameworks for business units and customer service operations. Building evaluation, monitoring and oversight frameworks for agent-based services in production.",
  },
  {
    company: "Banco Davivienda",
    role: "Unstructured Data Analytics Specialist",
    period: "2021 – 2026",
    description: "Researched, developed and implemented AI solutions for banking, applying generative language models, computer vision, machine learning, edge computing and audio processing.",
  },
  {
    company: "CENICAÑA",
    role: "Industrial Process Engineer",
    period: "2021",
    description: "Developed a software tool for dynamic simulation of PID automatic control systems in sugarcane juice evaporation and filtration processes. Designed and assembled electronic circuit boards for automatic control applications.",
  },
];

const education = [
  { program: "Bachelor’s Degree in Electronic Engineering", institution: "Universidad del Valle", period: "2015 – 2021" },
  { program: "Digital Transformation and Leadership", institution: "Massachusetts Institute of Technology", period: "2020" },
  { program: "English Language Studies", institution: "Universidad de Nariño", period: "2010 – 2012" },
];

const softSkills = ["Collaborative teamwork", "Proactiveness", "Cross-functional communication", "Fast learning & adaptability", "Business acumen", "Technology risk management"];

const recentCertifications = [
  { name: "Long-Term Agentic Memory With LangGraph", issuer: "DeepLearning.AI", date: "Jun 2026", focus: "Agent memory and persistent context" },
  { name: "Agentic AI", issuer: "DeepLearning.AI", date: "May 2026", focus: "Agentic AI concepts and patterns" },
  { name: "AI Agents in LangGraph", issuer: "DeepLearning.AI", date: "Apr 2026", focus: "Building and orchestrating AI agents" },
  { name: "A2A: The Agent2Agent Protocol", issuer: "DeepLearning.AI", date: "Apr 2026", focus: "Interoperability between AI agents" },
];

const projects = [
  {
    number: "01",
    type: "CONVERSATIONAL AI · SPEECH ANALYTICS",
    title: "Conversational Intelligence Pipeline",
    description: "An end-to-end approach to transform audio conversations into structured information and actionable business insights.",
    details: ["Audio transcription and diarization", "LLM-powered information extraction", "Structured outputs for downstream analytics"],
    stack: ["Python", "Audio processing", "LLMs", "Cloud"],
    note: "Professional experience · anonymized",
  },
  {
    number: "02",
    type: "GENERATIVE AI · KNOWLEDGE RETRIEVAL",
    title: "Knowledge-grounded AI Assistant",
    description: "A retrieval-augmented generation architecture designed to answer questions using relevant context from curated knowledge sources.",
    details: ["Document ingestion and chunking", "Embeddings and semantic retrieval", "Context-aware response generation"],
    stack: ["Python", "RAG", "Vector search", "LLMs"],
    note: "Architecture showcase",
  },
  {
    number: "03",
    type: "AGENTIC AI · AUTOMATION",
    title: "Tool-using Conversational Agent",
    description: "A modular conversational assistant that interprets user intent, selects tools and coordinates multi-step workflows.",
    details: ["Tool and API integration", "Conversation workflow orchestration", "Evaluation and human handoff"],
    stack: ["Python", "MCP", "LLMs", "Agent workflows"],
    note: "Architecture showcase",
  },
];
---
<BaseLayout title="Juan Manuel Romo | Generative AI Engineer" description="Juan Manuel Romo is an Electronic Engineer and Generative AI Engineer building enterprise AI agents, machine learning and cloud solutions.">
  <div class="relative overflow-hidden">
    <div class="soft-grid pointer-events-none absolute inset-0 opacity-70"></div>
    <header class="relative z-10 border-b border-white/[0.07]">
      <nav class="container-shell flex min-h-[76px] items-center justify-between gap-5" aria-label="Main navigation">
        <a href="#home" class="flex items-center gap-3 font-semibold tracking-tight">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl border border-indigo-300/25 bg-indigo-300/10 text-sm text-indigo-200">JR</span>
          <span>Juan Romo<span class="text-indigo-300">.</span></span>
        </a>
        <div class="hidden items-center gap-7 text-sm md:flex">
          <a class="nav-link" href="#about">About</a>
          <a class="nav-link" href="#expertise">Expertise</a>
          <a class="nav-link" href="#projects">Projects</a>
          <a class="nav-link" href="#experience">Experience</a>
          <a class="nav-link" href="#contact">Contact</a>
        </div>
        <a class="button-secondary !px-4 !py-2 text-xs" href="#contact">Let’s talk <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main>
      <section id="home" class="container-shell relative grid min-h-[650px] items-center gap-12 py-20 lg:grid-cols-[1.2fr_.8fr] lg:py-28">
        <div class="relative z-[1]">
          <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-emerald-300/20 bg-emerald-300/[0.06] px-3 py-2 text-xs text-emerald-200">
            <span class="h-2 w-2 rounded-full bg-emerald-300 shadow-[0_0_12px_#6ee7b7]"></span>
            GENERATIVE AI ENGINEER · BOGOTÁ, COLOMBIA
          </div>
          <p class="eyebrow mb-5">Hello, I’m Juan Manuel Romo</p>
          <h1 class="max-w-4xl text-5xl leading-[1.04] font-extrabold tracking-[-.055em] sm:text-6xl lg:text-[5.2rem]">
            Building <span class="gradient-text">generative AI</span> for the real world.
          </h1>
          <p class="muted mt-7 max-w-2xl text-base leading-8 sm:text-lg">
            Electronic Engineer focused on enterprise-grade Generative AI. I design and develop AI agents, computer vision and audio solutions, and the evaluation and monitoring systems that help them work reliably in production.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a class="button-primary" href="#experience">View my experience <span aria-hidden="true">↘</span></a>
            <a class="button-secondary" href="mailto:juanmaro1104@gmail.com">Get in touch</a>
          </div>
          <div class="mt-12 flex flex-wrap gap-x-7 gap-y-3 text-xs font-medium tracking-wide text-slate-400">
            <span>GENERATIVE AI</span><span>AI AGENTS</span><span>MACHINE LEARNING</span><span>CLOUD</span>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-[390px]">
          <div class="absolute -inset-8 rounded-full bg-indigo-500/10 blur-3xl"></div>
          <div class="glass relative overflow-hidden rounded-3xl p-3">
            <img src="/profile.jpg" alt="Portrait of Juan Manuel Romo" class="aspect-[4/5] w-full rounded-2xl object-cover" />
            <div class="absolute inset-x-3 bottom-3 rounded-b-2xl bg-gradient-to-t from-[#080b12] via-[#080b12]/80 to-transparent px-6 pb-6 pt-16">
              <p class="text-xs font-semibold tracking-widest text-emerald-200">GENERATIVE AI ENGINEER</p>
              <p class="mt-2 text-2xl font-semibold">Juan Manuel Romo</p>
              <p class="mt-1 text-sm text-slate-300">Bogotá, Colombia</p>
            </div>
          </div>
          <div class="absolute -right-3 -top-4 rounded-2xl border border-white/10 bg-[#111925] px-4 py-3 shadow-xl sm:-right-7">
            <p class="text-[10px] tracking-widest text-slate-500">EXPERIENCE</p>
            <p class="mt-1 text-sm font-semibold">AI in financial services</p>
          </div>
        </div>
      </section>

      <section id="about" class="section-space border-t border-white/[0.06]">
        <div class="container-shell grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
          <div><p class="eyebrow mb-4">01 / About</p><h2 class="section-title">Engineering <span class="gradient-text">useful AI.</span></h2></div>
          <div class="space-y-5 text-[15px] leading-8 text-slate-300">
            <p>I’m an Electronic Engineer specializing in Artificial Intelligence, with experience designing and developing enterprise-grade Generative AI solutions and services.</p>
            <p>I work across the full solution lifecycle—from autonomous conversational agents, computer vision and audio processing to evaluation, monitoring and oversight in production environments.</p>
            <p class="text-slate-400">My recent learning has also explored agent memory and how agents can work together through interoperable protocols—complementing my focus on building reliable systems for real business needs.</p>
          </div>
        </div>
      </section>

      <section id="expertise" class="section-space border-t border-white/[0.06] bg-white/[0.015]">
        <div class="container-shell">
          <div class="mb-12 max-w-2xl"><p class="eyebrow mb-4">02 / Expertise</p><h2 class="section-title">A practical <span class="gradient-text">technical toolkit.</span></h2><p class="muted mt-5 leading-7">Technologies and methods I use to design, build and operate AI services.</p></div>
          <div class="grid gap-4 sm:grid-cols-2">
            {skills.map((group, index) => (
              <article class="card p-6 sm:p-7">
                <div class="mb-6 flex items-center justify-between"><span class="text-sm font-semibold">{group.title}</span><span class="font-mono text-xs text-indigo-300">0{index + 1}</span></div>
                <div class="flex flex-wrap gap-2">{group.items.map((item) => <span class="pill">{item}</span>)}</div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="projects" class="section-space border-t border-white/[0.06]">
        <div class="container-shell">
          <div class="mb-12 flex flex-col justify-between gap-5 md:flex-row md:items-end">
            <div><p class="eyebrow mb-4">03 / Selected work</p><h2 class="section-title">Turning ideas into <span class="gradient-text">systems.</span></h2></div>
            <p class="muted max-w-md text-sm leading-7">Examples represent solution patterns and areas of work. Professional details are anonymized where needed.</p>
          </div>
          <div class="grid gap-5">
            {projects.map((project) => (
              <article class="card grid gap-6 p-6 md:grid-cols-[.35fr_1fr] md:p-8">
                <div class="flex items-start justify-between md:block"><span class="font-mono text-4xl font-light text-indigo-300/70">{project.number}</span><span class="pill md:mt-8">{project.note}</span></div>
                <div>
                  <p class="eyebrow !text-[.65rem]">{project.type}</p>
                  <h3 class="mt-3 text-2xl font-semibold tracking-tight">{project.title}</h3>
                  <p class="muted mt-3 max-w-3xl text-sm leading-7">{project.description}</p>
                  <ul class="mt-5 grid gap-2 text-sm text-slate-300 sm:grid-cols-2">
                    {project.details.map((detail) => <li class="flex gap-2"><span class="text-emerald-300">↳</span>{detail}</li>)}
                  </ul>
                  <div class="mt-6 flex flex-wrap gap-2">{project.stack.map((item) => <span class="pill !text-xs">{item}</span>)}</div>
                </div>
              </article>
            ))}
          </div>
          <p class="mt-5 text-xs leading-6 text-slate-500">These entries describe areas of work and illustrative architectures. Public project links can be added when available and appropriate to share.</p>
        </div>
      </section>

      <section id="experience" class="section-space border-t border-white/[0.06] bg-white/[0.015]">
        <div class="container-shell grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
          <div><p class="eyebrow mb-4">04 / Experience</p><h2 class="section-title">Building with <span class="gradient-text">purpose.</span></h2><p class="muted mt-5 text-sm leading-7">AI, engineering and technology experience across financial services and industrial processes.</p></div>
          <div class="timeline-line ml-2 space-y-10 pl-8">
            {experience.map((job) => (
              <article class="relative">
                <span class="dot absolute -left-[2.34rem] top-1"></span>
                <p class="text-xs tracking-widest text-indigo-300">{job.company.toUpperCase()} · {job.period.toUpperCase()}</p>
                <h3 class="mt-2 text-xl font-semibold">{job.role}</h3>
                <p class="mt-4 text-sm leading-7 text-slate-300">{job.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="education" class="section-space border-t border-white/[0.06]">
        <div class="container-shell grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
          <div><p class="eyebrow mb-4">05 / Education</p><h2 class="section-title">Learning through <span class="gradient-text">engineering.</span></h2></div>
          <div class="grid gap-4">
            {education.map((item) => (
              <article class="card p-6">
                <p class="text-xs tracking-widest text-indigo-300">{item.period}</p>
                <h3 class="mt-2 text-lg font-semibold">{item.program}</h3>
                <p class="muted mt-1 text-sm">{item.institution}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="certifications" class="border-t border-white/[0.06] py-12">
        <div class="container-shell">
          <div class="mb-8 max-w-2xl"><p class="eyebrow mb-4">06 / Recent learning</p><h2 class="text-2xl font-semibold">Exploring <span class="gradient-text">agentic AI.</span></h2><p class="muted mt-3 text-sm leading-7">Recent coursework complements my hands-on work with agent-based systems, with a focus on LangGraph, memory and interoperability.</p></div>
          <div class="grid gap-3 sm:grid-cols-2">
            {recentCertifications.map((certification) => (
              <article class="card p-5">
                <div class="flex items-start justify-between gap-4"><h3 class="text-sm font-semibold leading-6">{certification.name}</h3><span class="shrink-0 text-xs text-slate-500">{certification.date}</span></div>
                <p class="mt-2 text-xs text-indigo-200">{certification.issuer}</p>
                <p class="muted mt-3 text-xs leading-5">{certification.focus}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="more" class="border-t border-white/[0.06] bg-white/[0.015] py-12">
        <div class="container-shell grid gap-10 md:grid-cols-2">
          <div><p class="eyebrow mb-4">Beyond the code</p><h2 class="text-xl font-semibold">How I work</h2><div class="mt-5 flex flex-wrap gap-2">{softSkills.map((skill) => <span class="pill">{skill}</span>)}</div></div>
          <div><p class="eyebrow mb-4">Languages</p><h2 class="text-xl font-semibold">English · Advanced proficiency (C2)</h2></div>
        </div>
      </section>

      <section id="contact" class="section-space border-t border-white/[0.06]">
        <div class="container-shell">
          <div class="glass relative overflow-hidden rounded-3xl p-8 sm:p-12 lg:p-16">
            <div class="absolute -right-16 -top-24 h-72 w-72 rounded-full bg-indigo-500/15 blur-3xl"></div>
            <div class="relative max-w-2xl">
              <p class="eyebrow mb-4">07 / Contact</p>
              <h2 class="section-title">Let’s build something <span class="gradient-text">meaningful.</span></h2>
              <p class="muted mt-5 max-w-xl leading-7">Interested in Generative AI, AI agents or building reliable AI services? I’d be glad to connect.</p>
              <div class="mt-8 flex flex-wrap gap-3">
                <a class="button-primary" href="mailto:juanmaro1104@gmail.com">Email Juan <span aria-hidden="true">↗</span></a>
                <a class="button-secondary" href="https://github.com/juanmaro97" target="_blank" rel="noreferrer">GitHub ↗</a>
                <a class="button-secondary" href="https://www.linkedin.com/in/juan-romo97/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
              </div>
              <p class="mt-5 text-sm text-slate-400">Bogotá, Colombia · <a class="nav-link" href="tel:+573168781717">+57 316 878 1717</a></p>
            </div>
          </div>
          <footer class="flex flex-col gap-3 py-8 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
            <span>© {new Date().getFullYear()} Juan Manuel Romo. Built with Astro.</span>
            <a class="nav-link" href="#home">Back to top ↑</a>
          </footer>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
