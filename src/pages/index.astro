---
import BaseLayout from "../layouts/BaseLayout.astro";

const skills = [
  { title: "Generative AI & LLMs", items: ["LLM applications", "Prompt engineering", "RAG", "Embeddings", "Evaluation"] },
  { title: "Machine Learning", items: ["Python", "Deep learning", "NLP", "Computer vision", "Data science"] },
  { title: "AI Engineering", items: ["AI agents", "Tool calling", "Workflow orchestration", "API integration", "Information extraction"] },
  { title: "Cloud & MLOps", items: ["Google Cloud", "AWS", "Vertex AI", "Docker", "CI/CD"] },
];

const projects = [
  {
    number: "01",
    type: "CONVERSATIONAL AI · SPEECH ANALYTICS",
    title: "Conversational Intelligence Pipeline",
    description: "An end-to-end approach to transform large volumes of audio conversations into structured information and actionable business insights.",
    details: ["Audio transcription and diarization", "LLM-powered information extraction", "Structured outputs for downstream analytics"],
    stack: ["Python", "Whisper", "LLMs", "Cloud Storage"],
    note: "Professional experience · anonymized"
  },
  {
    number: "02",
    type: "GENERATIVE AI · KNOWLEDGE RETRIEVAL",
    title: "Knowledge-grounded AI Assistant",
    description: "A retrieval-augmented generation architecture designed to answer questions using relevant context from curated knowledge sources.",
    details: ["Document ingestion and chunking", "Vector embeddings and semantic retrieval", "Context-aware response generation"],
    stack: ["Python", "RAG", "Vector Search", "LLMs"],
    note: "Architecture showcase"
  },
  {
    number: "03",
    type: "AGENTIC AI · AUTOMATION",
    title: "Tool-using Conversational Agent",
    description: "A modular conversational assistant that interprets user intent, selects tools and coordinates multi-step workflows.",
    details: ["Tool and API integration", "Conversation flow orchestration", "Evaluation and human handoff considerations"],
    stack: ["Python", "LLMs", "APIs", "Agent Workflows"],
    note: "Architecture showcase"
  },
];
---
<BaseLayout>
  <div class="relative overflow-hidden">
    <div class="soft-grid pointer-events-none absolute inset-0 opacity-70"></div>
    <header class="relative z-10 border-b border-white/[0.07]">
      <nav class="container-shell flex min-h-[76px] items-center justify-between gap-5" aria-label="Main navigation">
        <a href="#home" class="flex items-center gap-3 font-semibold tracking-tight">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl border border-indigo-300/25 bg-indigo-300/10 text-sm text-indigo-200">JR</span>
          <span>Juan Romo<span class="text-indigo-300">.</span></span>
        </a>
        <div class="hidden items-center gap-7 text-sm md:flex">
          <a class="nav-link" href="#about">About</a>
          <a class="nav-link" href="#expertise">Expertise</a>
          <a class="nav-link" href="#projects">Projects</a>
          <a class="nav-link" href="#experience">Experience</a>
          <a class="nav-link" href="#contact">Contact</a>
        </div>
        <a class="button-secondary !px-4 !py-2 text-xs" href="#contact">Let's talk <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main>
      <section id="home" class="container-shell relative grid min-h-[690px] items-center gap-12 py-24 lg:grid-cols-[1.25fr_.75fr] lg:py-32">
        <div class="relative z-[1]">
          <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-emerald-300/20 bg-emerald-300/[0.06] px-3 py-2 text-xs text-emerald-200">
            <span class="h-2 w-2 rounded-full bg-emerald-300 shadow-[0_0_12px_#6ee7b7]"></span>
            AI ENGINEER · OPEN TO MEANINGFUL CHALLENGES
          </div>
          <p class="eyebrow mb-5">Hello, I'm Juan Romo</p>
          <h1 class="max-w-4xl text-5xl leading-[1.04] font-extrabold tracking-[-.055em] sm:text-6xl lg:text-[5.2rem]">
            Engineering <span class="gradient-text">intelligent</span> solutions with AI.
          </h1>
          <p class="muted mt-7 max-w-2xl text-base leading-8 sm:text-lg">
            Electronic Engineer focused on Generative AI, LLM-powered applications, machine learning and cloud-based intelligent systems — turning complex data into practical solutions.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a class="button-primary" href="#projects">Explore my work <span aria-hidden="true">↗</span></a>
            <a class="button-secondary" href="#contact">Get in touch</a>
          </div>
          <div class="mt-12 flex flex-wrap gap-x-7 gap-y-3 text-xs font-medium tracking-wide text-slate-400">
            <span>GENERATIVE AI</span><span>LLM ENGINEERING</span><span>MACHINE LEARNING</span><span>CLOUD</span>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-[390px]">
          <div class="absolute -inset-8 rounded-full bg-indigo-500/10 blur-3xl"></div>
          <div class="glass relative rounded-3xl p-5 sm:p-6">
            <div class="flex items-center justify-between border-b border-white/10 pb-4">
              <span class="text-xs font-semibold tracking-widest text-slate-400">ENGINEERING PROFILE</span>
              <span class="text-xs text-emerald-300">● AVAILABLE</span>
            </div>
            <div class="mt-6 space-y-5 font-mono text-xs">
              <div class="text-slate-500">// What I work on</div>
              <div><span class="text-indigo-300">const</span> <span class="text-cyan-200">focus</span> = [</div>
              <div class="space-y-3 pl-5">
                <p><span class="text-emerald-200">"generative-ai"</span>,</p>
                <p><span class="text-emerald-200">"llm-applications"</span>,</p>
                <p><span class="text-emerald-200">"intelligent-agents"</span>,</p>
                <p><span class="text-emerald-200">"machine-learning"</span>,</p>
                <p><span class="text-emerald-200">"cloud-engineering"</span></p>
              </div>
              <div>];</div>
              <div class="my-5 h-px bg-white/10"></div>
              <div class="text-slate-500">// My approach</div>
              <div class="leading-7 text-slate-300">
                <span class="text-violet-300">build</span>(<span class="text-emerald-200">"useful AI"</span>)<br />
                <span class="text-violet-300">measure</span>(<span class="text-emerald-200">"real impact"</span>)<br />
                <span class="text-violet-300">improve</span>(<span class="text-emerald-200">"continuously"</span>)
              </div>
              <div class="flex items-center gap-2 pt-2 text-slate-500"><span class="h-2 w-2 animate-pulse rounded-full bg-indigo-300"></span> building what comes next<span class="text-indigo-300">_</span></div>
            </div>
          </div>
          <div class="absolute -right-4 -bottom-5 rounded-2xl border border-white/10 bg-[#111925] px-4 py-3 shadow-xl sm:-right-8">
            <p class="text-[10px] tracking-widest text-slate-500">BASED IN</p>
            <p class="mt-1 text-sm font-semibold">Bogotá, Colombia</p>
          </div>
        </div>
      </section>

    <section id="about" class="section-space border-t border-white/[0.06]">
      <div class="container-shell grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
        <div><p class="eyebrow mb-4">01 / About</p><h2 class="section-title">Curiosity meets <span class="gradient-text">engineering.</span></h2></div>
        <div class="space-y-5 text-[15px] leading-8 text-slate-300">
          <p>I'm an Electronic Engineer with a strong interest in the intersection of artificial intelligence, data and software engineering. My work focuses on designing solutions that make complex information more accessible, useful and actionable.</p>
          <p>I work across the lifecycle of AI-powered applications: understanding the problem, shaping the data, designing the architecture, integrating models and evaluating the resulting solution.</p>
          <p class="text-slate-400">I believe useful AI is not just about choosing a powerful model. It's about building reliable systems around it.</p>
        </div>
      </div>
    </section>

    <section id="expertise" class="section-space border-t border-white/[0.06] bg-white/[0.015]">
      <div class="container-shell">
        <div class="mb-12 max-w-2xl"><p class="eyebrow mb-4">02 / Expertise</p><h2 class="section-title">A practical <span class="gradient-text">technical toolkit.</span></h2><p class="muted mt-5 leading-7">The methods, tools and technologies I use to design and deliver intelligent applications.</p></div>
        <div class="grid gap-4 sm:grid-cols-2">
          {skills.map((group, index) => (
            <article class="card p-6 sm:p-7">
              <div class="mb-6 flex items-center justify-between"><span class="text-sm font-semibold">{group.title}</span><span class="font-mono text-xs text-indigo-300">0{index + 1}</span></div>
              <div class="flex flex-wrap gap-2">{group.items.map((item) => <span class="pill">{item}</span>)}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="projects" class="section-space border-t border-white/[0.06]">
      <div class="container-shell">
        <div class="mb-12 flex flex-col justify-between gap-5 md:flex-row md:items-end">
          <div><p class="eyebrow mb-4">03 / Selected work</p><h2 class="section-title">Turning ideas into <span class="gradient-text">systems.</span></h2></div>
          <p class="muted max-w-md text-sm leading-7">A selection of solution patterns and areas of work. Professional examples are intentionally anonymized where needed.</p>
        </div>
        <div class="grid gap-5">
          {projects.map((project) => (
            <article class="card grid gap-6 p-6 md:grid-cols-[.35fr_1fr] md:p-8">
              <div class="flex items-start justify-between md:block"><span class="font-mono text-4xl font-light text-indigo-300/70">{project.number}</span><span class="pill md:mt-8">{project.note}</span></div>
              <div>
                <p class="eyebrow !text-[.65rem]">{project.type}</p>
                <h3 class="mt-3 text-2xl font-semibold tracking-tight">{project.title}</h3>
                <p class="muted mt-3 max-w-3xl text-sm leading-7">{project.description}</p>
                <ul class="mt-5 grid gap-2 text-sm text-slate-300 sm:grid-cols-2">
                  {project.details.map((detail) => <li class="flex gap-2"><span class="text-emerald-300">↳</span>{detail}</li>)}
                </ul>
                <div class="mt-6 flex flex-wrap gap-2">{project.stack.map((item) => <span class="pill !text-xs">{item}</span>)}</div>
              </div>
            </article>
          ))}
        </div>
        <p class="mt-5 text-xs leading-6 text-slate-500">Note: These entries describe areas of work and illustrative architectures. Add links to public repositories or demos only when they are available and safe to share.</p>
      </div>
    </section>

    <section id="experience" class="section-space border-t border-white/[0.06] bg-white/[0.015]">
      <div class="container-shell grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
        <div><p class="eyebrow mb-4">04 / Experience</p><h2 class="section-title">Building with <span class="gradient-text">purpose.</span></h2><p class="muted mt-5 text-sm leading-7">Professional experience at the intersection of data, technology and business challenges.</p></div>
        <div class="timeline-line ml-2 space-y-10 pl-8">
          <article class="relative">
            <span class="dot absolute -left-[2.34rem] top-1"></span>
            <p class="text-xs tracking-widest text-indigo-300">FINANCIAL SERVICES · COLOMBIA</p>
            <h3 class="mt-2 text-xl font-semibold">AI & Data Engineering</h3>
            <p class="muted mt-1 text-sm">Professional experience · Add exact title and dates</p>
            <p class="mt-4 text-sm leading-7 text-slate-300">Contributing to data and AI initiatives involving unstructured information, analytics, risk and data governance. Focused on applying machine learning and generative AI techniques to transform complex information into structured insights.</p>
          </article>
          <article class="relative">
            <span class="dot absolute -left-[2.34rem] top-1"></span>
            <p class="text-xs tracking-widest text-indigo-300">EDUCATION</p>
            <h3 class="mt-2 text-xl font-semibold">Electronic Engineering</h3>
            <p class="muted mt-1 text-sm">Add university name and graduation year</p>
            <p class="mt-4 text-sm leading-7 text-slate-300">Engineering foundation complemented by continued learning in data science, machine learning, deep learning and cloud technologies.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="certifications" class="section-space border-t border-white/[0.06]">
      <div class="container-shell">
        <p class="eyebrow mb-4">05 / Certifications</p>
        <h2 class="section-title mb-9">Learning, <span class="gradient-text">validated.</span></h2>
        <article class="card flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
          <div><p class="text-xs tracking-widest text-slate-400">GOOGLE CLOUD</p><h3 class="mt-2 text-lg font-semibold">Associate Cloud Engineer</h3><p class="muted mt-1 text-sm">Google Cloud · Credential earned</p></div>
          <span class="pill w-fit">Cloud certification</span>
        </article>
        <p class="muted mt-4 text-xs">Add credential verification links and any additional certifications here.</p>
      </div>
    </section>

    <section id="contact" class="section-space border-t border-white/[0.06]">
      <div class="container-shell">
        <div class="glass relative overflow-hidden rounded-3xl p-8 sm:p-12 lg:p-16">
          <div class="absolute -right-16 -top-24 h-72 w-72 rounded-full bg-indigo-500/15 blur-3xl"></div>
          <div class="relative max-w-2xl">
            <p class="eyebrow mb-4">06 / Contact</p>
            <h2 class="section-title">Have an interesting <span class="gradient-text">challenge?</span></h2>
            <p class="muted mt-5 max-w-xl leading-7">I'm always interested in exchanging ideas and exploring opportunities to build useful technology. Let's connect.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <!-- Replace the placeholder email with your professional email. -->
              <a class="button-primary" href="mailto:YOUR_EMAIL@example.com">Email me <span aria-hidden="true">↗</span></a>
              <a class="button-secondary" href="https://github.com/juanmaro97" target="_blank" rel="noreferrer">GitHub ↗</a>
              <!-- Replace # with your LinkedIn profile URL. -->
              <a class="button-secondary" href="#" aria-label="Add your LinkedIn profile URL">LinkedIn ↗</a>
            </div>
          </div>
        </div>
        <footer class="flex flex-col gap-3 py-8 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
          <span>© {new Date().getFullYear()} Juan Romo. Built with Astro.</span>
          <a class="nav-link" href="#home">Back to top ↑</a>
        </footer>
      </div>
    </section>
  </main>
  </div>
</BaseLayout>
